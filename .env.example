# ── Obrigatório no primeiro uso (pareamento) ─────────────────────────────
# Seu número com DDI+DDD, só dígitos. Ex.: 5513999999999
WHATSAPP_PHONE=

# ── Uso ──────────────────────────────────────────────────────────────────
COMMAND_PREFIX=.
PACK_NAME=Matrizz Stickers
PACK_AUTHOR=Sticker Bot
# Números (só dígitos, separados por vírgula) que também podem usar .sticker.
# Vazio = somente você (mensagens enviadas pelo seu próprio número).
ALLOWED_NUMBERS=
# Apaga a mensagem ".sticker" depois de enviar a figurinha (só funciona nas suas mensagens)
DELETE_COMMAND_MESSAGE=false

# ── Limites (proteção do notebook) ───────────────────────────────────────
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=10
JOB_TIMEOUT_SECONDS=60
MAX_VIDEO_SECONDS=10
MAX_INPUT_MB=25
MAX_ANIMATED_KB=800
USER_COOLDOWN_SECONDS=3

# ── Operação ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
TZ=America/Sao_Paulo
# Se não conectar por este tempo, o processo se reinicia sozinho
WATCHDOG_MINUTES=10
# (opcional) URL de "Push" de um monitor do Uptime Kuma
KUMA_PUSH_URL=
